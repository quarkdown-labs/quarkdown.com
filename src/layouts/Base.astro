---
import { Font } from 'astro:assets';
import '../styles/global.scss';
import BackgroundEffects from '../components/BackgroundEffects.astro';
import Navbar from '../components/Navbar.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel=apple-touch-icon href="/apple-touch-icon.png">
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name=description content="Markdown with superpowers: a modern typesetting system for papers, presentations and knowledge bases.">
    <meta name=keywords content="typesetting,markdown,latex,compiler,document creation,paper,presentation,slides,static site generator,wiki,PDF,live preview">
    <meta name=author content="Giorgio Garofalo">
    <meta property="og:title" content="Quarkdown">
    <meta property="og:description" content="Markdown with superpowers: a modern typesetting system for papers, presentations and knowledge bases.">
    <meta property="og:image" content="https://raw.githubusercontent.com/iamgio/quarkdown/project-files/images/banner-light.png">
    <meta name=msapplication-TileColor content="#FFFFFF">
    <meta name=theme-color content="#FFFFFF">
    <meta itemprop=operatingSystem content="Cross-platform">
    <meta itemprop=applicationCategory content="DeveloperApplication">
    <link href=https://quarkdown.com/ rel=canonical>
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-code" preload />
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "7ff9d84e763543269faa5a5ae685ef9d"}'></script>
    <title>Quarkdown</title>
  </head>
  <body>
    <BackgroundEffects />
    <Navbar />
    <slot />
    <script src="../scripts/copyable.ts"></script>
  </body>
</html>
