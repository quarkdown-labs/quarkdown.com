---
import Head from './Head.astro';

interface Props {
  to: string;
}

const { to } = Astro.props;
---

<!DOCTYPE html>
<html>
  <head>
    <Head>
      <meta http-equiv="refresh" content={`0; ${to}`} />
    </Head>
  </head>
  <body>
    <p>Redirecting to <a href={to}>{to}</a>…</p>
  </body>
</html>
