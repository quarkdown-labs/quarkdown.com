---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { meta } from '../meta';

interface Crumb {
  href: string;
  label: string;
}

interface Props {
  /** The page heading, also the first part of the document title. */
  title: string;
  description: string;
  /** Trail after the site root, which always leads it. */
  breadcrumbs?: Crumb[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
---

<Base title={`${title} | ${meta.name}`} description={description}>
  <main class="prose-page">
    <header>
      <div class="breadcrumbs-row">
        <Breadcrumbs items={[{ href: '/', label: meta.name }, ...breadcrumbs]} />
      </div>
      <h1 class="hero-title">{title}</h1>
      {Astro.slots.has('lead') && <p class="lead"><slot name="lead" /></p>}
    </header>

    <article class="prose">
      <slot />
    </article>
  </main>

  <Footer />
</Base>

<style lang="scss">
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .prose-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 9rem 1.5rem 5rem;

    @include md-down {
      padding-top: 7rem;
    }
  }

  header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .breadcrumbs-row {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: $font-prose;
    font-size: $font-size-h1-prose;
    font-weight: 700;
    letter-spacing: normal;
  }

  .lead {
    @include prose;
    margin-top: 1.25rem;
  }
</style>
