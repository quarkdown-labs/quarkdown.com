---
import type { ResolvedAuthor } from '../authors';

interface Props {
  author: ResolvedAuthor;
}

const { author } = Astro.props;
---

<aside class="author-card">
  <a href={author.url} target="_blank" rel="noopener" class="avatar-link" aria-label={`${author.name} on GitHub`}>
    <img
      src={author.avatar}
      alt={author.name}
      width="48"
      height="48"
      loading="lazy"
      class="avatar"
    />
  </a>
  <div class="text">
    <p class="name">
      <a href={author.url} target="_blank" rel="noopener">{author.name}</a>
    </p>
    <p class="bio">{author.bio}</p>
  </div>
</aside>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/container' as *;

  .author-card {
    @include styled-container;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    margin-top: 6rem;
  }

  .avatar-link {
    flex-shrink: 0;
    display: block;
    line-height: 0;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .text {
    min-width: 0;
  }

  .name {
    margin: 0 0 0.4rem;
    color: $heading;

    a {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s;

      &:hover {
        opacity: 0.75;
      }
    }
  }

  .bio {
    margin: 0;
    color: $text-faint;
    font-size: $font-size-overline;
    line-height: $line-height-text;
  }
</style>
