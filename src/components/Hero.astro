---
import DotPattern from './DotPattern.astro';
import GetStartedActionPair from './GetStartedActionPair.astro';
import HeroVisual from './HeroVisual.astro';
---

<section class="hero">
  <DotPattern />

  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-title">
        Markdown <span class="faint">with</span>
        <br />
        <strong>superpowers</strong>
      </h1>

      <p class="hero-subtitle">
        Markdown meets the power of LaTeX.
        <br />
        And it's free and open source.
      </p>

      <GetStartedActionPair />
    </div>

    <HeroVisual />
  </div>
</section>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .hero {
    position: relative;
    background: linear-gradient($brand-700 -10%, $brand-900 100%);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    gap: 1rem;

    @include md-down {
      flex-direction: column;
      text-align: center;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    margin-top: 1rem;

    @include md-down {
      align-items: center;
      margin-top: 0;
    }
  }

  .hero-title {
    font-family: $font-body;
    font-size: $font-size-h1;
    line-height: 0.85;
    margin-bottom: 1.5rem;
    strong {
      @include heading;
      font-size: 1.2em;
    }
  }

  .hero-subtitle {
    @include text;
    font-size: $font-size-body;
    margin-bottom: 2rem;
  }
</style>
