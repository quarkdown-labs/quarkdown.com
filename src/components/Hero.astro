---
import Logo from '../assets/logo.svg';
import DotPattern from './DotPattern.astro';
import TagList from './TagList.astro';
import GetStartedActionPair from './GetStartedActionPair.astro';

const tags = ['Papers', 'Books', 'Presentations', 'Static sites', 'Knowledge bases'];
---

<section class="hero">
  <DotPattern />

  <div class="hero-content">
    <Logo class="hero-logo" aria-label="Quarkdown" />

    <h1 class="hero-title">
      Markdown <span class="faint">with</span>
      <br />
      <strong>superpowers</strong>
    </h1>

    <TagList tags={tags} />

    <p class="hero-subtitle">
      Markdown meets the power of LaTeX in this modern typesetting system.
      <br />
      And it's free and open source.
    </p>

    <GetStartedActionPair />
  </div>
</section>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .hero {
    position: relative;
    background: linear-gradient($brand-700 -10%, $brand-900 100%);
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-logo {
    width: 120px;
    height: auto;
    margin-bottom: 2.5rem;
    filter: drop-shadow($glow);
  }

  .hero-title {
    font-family: $font-body;
    font-size: $font-size-h1;
    line-height: 1.15;
    margin-bottom: 2.5rem;
    text-shadow: $glow;

    strong {
      @include heading;
      font-size: 1.2em;
    }
  }

  .hero-content > :global(.tag-list) {
    margin-bottom: 2.5rem;
  }

  .hero-subtitle {
    font-size: $font-size-body;
    color: $text;
    line-height: 1.7;
    margin-bottom: 3rem;
  }


</style>
