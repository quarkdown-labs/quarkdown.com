---
import Logo from '../assets/logo.svg';

const tags = ['Papers', 'Books', 'Presentations', 'Static sites', 'Knowledge bases'];
---

<section class="hero">
  <div class="hero-content">
    <Logo class="hero-logo" aria-label="Quarkdown" />

    <h1 class="hero-title">
      Markdown <span class="faint">with</span>
      <br />
      <strong>superpowers</strong>
    </h1>

    <ul class="hero-tags">
      {tags.map(tag => <li>{tag}</li>)}
    </ul>

    <p class="hero-subtitle">
      Markdown meets the power of LaTeX in this modern typesetting system.
      <br />
      And it's free and open source.
    </p>

    <div class="hero-cta">
      <a href="#learn-more" class="cta-link">Learn more</a>
      <a href="https://github.com/iamgio/quarkdown" class="cta-button">Get started &rarr;</a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .hero {
    position: relative;
    background: linear-gradient($brand-600 -10%, $brand-900 100%);
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, $brand-400 2px, transparent 2px);
      background-size: 36px 36px;
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 70%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 70%);
      pointer-events: none;
    }
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  $glow: 0 0 25px rgba(255, 255, 255, 0.25);

  .hero-logo {
    width: 120px;
    height: auto;
    margin-bottom: 2.5rem;
    filter: drop-shadow($glow);
  }

  .hero-title {
    font-family: $font-body;
    font-size: $font-size-h1;
    line-height: 1.15;
    margin-bottom: 3rem;
    text-shadow: $glow;

    .faint {
      color: $text-faint;
    }

    strong {
      @include heading;
      font-size: 1.2em;
    }
  }

  .hero-subtitle {
    font-size: $font-size-body;
    color: $text;
    line-height: 1.7;
    margin-bottom: 3rem;
    text-shadow: $glow;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    list-style: none;
    padding: 1rem 0;
    margin-bottom: 2.5rem;

    li {
      font-size: $font-size-overline;
      letter-spacing: $letter-spacing-sans;
      color: $text-faint;
      text-transform: uppercase;
    }
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .cta-link {
    font-family: $font-body;
    font-size: $font-size-cta;
    color: $heading;
    text-decoration: none;
  }

  .cta-button {
    font-family: $font-body;
    font-size: $font-size-cta;
    color: $heading;
    text-decoration: none;
    background-color: $brand-800;
    border: solid $heading;
    border-width: 1px 0.5px 0.5px 2px;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;

    &:hover {
      background-color: $brand-700;
    }
  }
</style>
