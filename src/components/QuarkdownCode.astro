---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  code: string;
  output?: ImageMetadata;
  alt?: string;
  vertical?: boolean;
}

const { code, output, alt = '', vertical = false } = Astro.props;
---

<div class:list={['code-with-output', { vertical }]}>
  <pre><code set:html={code} /></pre>
  {output ? (
    <Image src={output} alt={alt} class="output" />
  ) : null}
</div>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .code-with-output {
    display: flex;
    align-items: center;

    &:has(.output) {
      width: 100%;
    }
  }

  pre:has(+ .output) {
    flex: 3;
    overflow: hidden;
    transform: translateX(32px) perspective(400px) rotateY(1deg);
  }

  .output {
    flex: 2;
    max-width: 50%;
    height: auto;
    border-radius: 10px;
    border: 1px solid $brand-400;
    transform: perspective(400px) rotateY(-3deg);
    box-shadow: $glow;
  }

  .vertical {
    flex-direction: column;
    align-items: center;

    pre {
      flex: none;
      overflow: visible;
      transform: none;
      z-index: 1;
      margin-bottom: -1.5rem;
      box-shadow: 0 10px 28px rgba($brand-700, 0.5);
    }

    .output {
      flex: none;
      max-width: 100%;
      height: 450px;
      width: auto;
      border: none;
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 768px) {
    .code-with-output {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    pre:has(+ .output) {
      flex: none;
      overflow: visible;
      transform: none;
    }

    .output {
      flex: none;
      max-width: 100%;
      transform: none;
    }
  }

  /* Syntax highlight classes */

  pre :global(.hl-keyword) {
    color: #FFFFFF;
  }

  pre :global(.hl-function) {
    color: #C792EA;
  }

  pre :global(.hl-string) {
    color: #C3E88D;
  }

  pre :global(.hl-heading) {
    color: #FFCB6B;
  }

  pre :global(.hl-comment) {
    color: #546E7A;
  }

  pre :global(.hl-punctuation) {
    color: #9e9e9e;
  }

  pre :global(.hl-reference) {
    color: #82AAFF;
  }

  pre :global(.hl-quote) {
    color: #89DDFF;
    font-style: italic;
  }
</style>
