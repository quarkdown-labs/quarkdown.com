---
interface Props {
  label?: string;
}

const { label = 'Terminal' } = Astro.props;
---

<div class="terminal" aria-label={label}>
  <div class="terminal-bar" aria-hidden="true">
    <span class="dot dot-red"></span>
    <span class="dot dot-amber"></span>
    <span class="dot dot-green"></span>
  </div>
  <div class="terminal-body">
    <slot />
  </div>
</div>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/container' as *;
  @use '../styles/breakpoints' as *;

  .terminal {
    @include styled-container;
    width: 100%;
    overflow: hidden;
    text-align: left;
  }

  .terminal-bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background-color: $brand-700;
    border-bottom: 1px solid $brand-500;
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red { background-color: #FF5F56; }
  .dot-amber { background-color: #FFBD2E; }
  .dot-green { background-color: #27C93F; }

  .terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: $font-code;
    font-size: $font-size-terminal;
    line-height: 1.7;
  }

  @include sm-down {
    .terminal-body {
      padding: 1rem 1.1rem;
    }
  }
</style>
