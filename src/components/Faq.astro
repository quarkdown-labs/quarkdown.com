---
import { faqs } from '../faqs';
---

<div class="faq-list">
  {faqs.map(({ question, answer }, index) => (
    <details class="faq-item" open={index === 0}>
      <summary class="faq-question">
        <span class="faq-question-text">{question}</span>
        <span class="faq-toggle" aria-hidden="true"></span>
      </summary>
      <div class="faq-answer" set:html={answer}></div>
    </details>
  ))}
</div>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .faq-item {
    background-color: $brand-900;
    border: 1px solid $brand-600;
    border-radius: 12px;
    overflow: hidden;
    transition: background-color 0.2s, border-color 0.2s;

    &:not([open]):hover {
      background-color: $brand-700;
    }

    &[open] {
      border-color: $brand-400;
    }
  }

  .faq-question {
    @include text;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.75rem;
    color: $heading;
    cursor: pointer;
    list-style: none;
    user-select: none;

    &::-webkit-details-marker {
      display: none;
    }

    @include sm-down {
      padding: 1rem 1.25rem;
      gap: 1rem;
    }
  }

  .faq-question-text {
    flex: 1;
  }

  .faq-toggle {
    flex-shrink: 0;
    position: relative;
    width: 1rem;
    height: 1rem;
    color: $text-faint;

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      background-color: currentColor;
      border-radius: 2px;
      transition: transform 0.2s;
    }

    &::before {
      width: 1rem;
      height: 2px;
      transform: translate(-50%, -50%);
    }

    &::after {
      width: 2px;
      height: 1rem;
      transform: translate(-50%, -50%);
    }
  }

  .faq-item[open] .faq-toggle {
    color: $heading;

    &::after {
      transform: translate(-50%, -50%) scaleY(0);
    }
  }

  .faq-answer {
    @include text;
    padding: 0 1.75rem 1.5rem;
    list-style-position: inside;

    @include sm-down {
      padding: 0 1.25rem 1.25rem;
    }
  }
</style>
