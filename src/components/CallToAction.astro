---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  /** Destination of the action. Without one, the action renders as a button for scripts to handle. */
  href?: string;
  variant?: 'link' | 'primary' | 'secondary' | 'studio';
  /** Whether the action spans the full width of its container. */
  wide?: boolean;
}

const { href, variant = 'link', wide, ...attributes } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element href={href} type={href ? undefined : 'button'} class:list={['cta', `cta--${variant}`, { 'cta--wide': wide }]} {...attributes}>
  <slot />
</Element>

<style lang="scss">
  @use 'sass:color';
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: $font-body;
    font-size: $font-size-cta;
    color: $heading;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  // Buttons lose the user agent's look; the button variants below draw their own.
  .cta--link {
    background: none;
    border: none;
  }

  // An action that leads nowhere, e.g. the plan the visitor already holds.
  .cta[aria-disabled='true'] {
    pointer-events: none;
    opacity: 0.6;
  }

  .cta--wide {
    display: flex;
    justify-content: center;
  }

  .cta--link:hover {
    text-decoration: underline;
  }

  %cta-button {
    border: solid $heading;
    border-width: 0.065rem 0.05rem 0.05rem 0.13rem;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
  }

  .cta--primary {
    @extend %cta-button;
    background-color: $heading;
    color: $brand-900;

    &:hover {
      background-color: $brand-100;
    }
  }

  .cta--secondary {
    @extend %cta-button;
    background-color: $brand-800;

    &:hover {
      background-color: $brand-700;
    }
  }

  .cta--studio {
    @extend %cta-button;
    background-color: $studio;
    border-color: color.scale($studio, $lightness: -50%);
    border-width: 2px;
    color: $heading;

    &:hover {
      background-color: $studio-hover;
    }
  }
</style>
