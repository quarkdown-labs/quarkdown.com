---
interface Props {
  href: string;
  variant?: 'link' | 'primary' | 'secondary';
}

const { href, variant = 'link' } = Astro.props;
---

<a href={href} class:list={['cta', `cta--${variant}`]}>
  <slot />
</a>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: $font-body;
    font-size: $font-size-cta;
    color: $heading;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .cta--link:hover {
    text-decoration: underline;
  }

  %cta-button {
    border: solid $heading;
    border-width: 0.065rem 0.05rem 0.05rem 0.13rem;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
  }

  .cta--primary {
    @extend %cta-button;
    background-color: $heading;
    color: $brand-900;

    &:hover {
      background-color: $brand-50;
    }
  }

  .cta--secondary {
    @extend %cta-button;
    background-color: $brand-800;

    &:hover {
      background-color: $brand-700;
    }
  }
</style>
