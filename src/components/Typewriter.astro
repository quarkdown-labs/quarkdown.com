---
/**
 * Typewriter animation powered by `typewriter-effect`, triggered by scrolling or on load.
 *
 * Renders the full text as a visually hidden but crawlable placeholder
 * for SEO and accessibility (`opacity: 0` is still announced by screen
 * readers). When the element scrolls into view (or as soon as the page
 * loads, with `start="load"`), the typewriter animation begins. A
 * `<noscript>` fallback restores the placeholder for no-JS browsers and
 * crawlers (progressive enhancement).
 *
 * @example
 * <h2>Spend your time <Typewriter text="writing" /></h2>
 */
interface Props {
  /** The text to type out. */
  text: string;
  /** Average typing speed in ms per character, eased slower at both ends of the text. Default: 80 */
  delay?: number;
  /** When typing begins: once scrolled to eye level, or as soon as the page loads. Default: scroll */
  start?: 'scroll' | 'load';
}

const { text, delay = 80, start = 'scroll' } = Astro.props;
---

<span class="typewriter-wrapper">
  <span class="typewriter-placeholder">{text}</span>
  <span class="typewriter" data-typewriter data-text={text} data-delay={delay} data-start={start}></span>
  <noscript><style>.typewriter-placeholder { opacity: 1 !important; }</style></noscript>
</span>

<script>
  import Typewriter from "typewriter-effect/dist/core";

  const CURSOR_HIDE_PAUSE = 1200;
  // How much slower than average the first and last characters are typed, and faster the middle ones.
  const EASE_STRENGTH = 0.6;
  const TYPE_ROOT_MARGIN = "-30% 0px -30% 0px";

  const instances = new Map<Element, Typewriter>();
  const pendingStart = new Set<Element>();

  /**
   * Delay before typing the [index]th of [count] characters, eased in and out around an [average]:
   * slow at both ends, fast in the middle, so the whole text takes as long as at a constant [average].
   */
  function easedDelay(index: number, count: number, average: number): number {
    const progress = count > 1 ? index / (count - 1) : 0;
    return average * (1 + EASE_STRENGTH * Math.cos(2 * Math.PI * progress));
  }

  function createTypewriter(el: HTMLSpanElement): Typewriter {
    const chars = [...el.dataset.text!];
    const delay = Number(el.dataset.delay);
    const typewriter = new Typewriter(el, { delay, cursor: "|" });

    // The typewriter waits its current delay before every queued event, changing the delay included:
    // halving it makes each character wait its eased delay in total, across both events.
    chars.forEach((char, i) => typewriter.changeDelay(easedDelay(i, chars.length, delay) / 2).typeString(char));

    return typewriter
      .pauseFor(CURSOR_HIDE_PAUSE)
      .callFunction(({ elements }: { elements: { cursor: HTMLElement } }) => {
        elements.cursor.style.visibility = "hidden";
      });
  }

  // Creates the typewriter instance as soon as the element enters the viewport.
  // If typing was already requested (race condition), starts immediately.
  const hideObserver = new IntersectionObserver((entries, obs) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;

      const el = entry.target.querySelector("[data-typewriter]") as HTMLSpanElement;
      const instance = createTypewriter(el);
      instances.set(entry.target, instance);

      if (pendingStart.has(entry.target)) {
        instance.start();
        pendingStart.delete(entry.target);
      }

      obs.unobserve(entry.target);
    }
  });

  // Starts the typing animation when the element reaches eye level.
  const typeObserver = new IntersectionObserver(
    (entries, obs) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;

        const instance = instances.get(entry.target);
        if (instance) {
          instance.start();
        } else {
          pendingStart.add(entry.target);
        }

        obs.unobserve(entry.target);
      }
    },
    { rootMargin: TYPE_ROOT_MARGIN },
  );

  document.querySelectorAll<HTMLSpanElement>("[data-typewriter]").forEach((el) => {
    if (el.dataset.start === "load") {
      createTypewriter(el).start();
      return;
    }

    const wrapper = el.parentElement!;
    hideObserver.observe(wrapper);
    typeObserver.observe(wrapper);
  });
</script>

<style lang="scss">
  .typewriter-wrapper {
    display: inline-block;
    position: relative;
  }

  .typewriter-placeholder {
    opacity: 0;
  }

  .typewriter {
    position: absolute;
    left: 0;
    top: 0;
    display: inline;

    :global(.Typewriter),
    :global(.Typewriter__wrapper),
    :global(.Typewriter__cursor) {
      display: inline;
    }
  }
</style>
