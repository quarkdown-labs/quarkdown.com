---
import { links } from '../links';
import Banner from '../assets/banner.svg';
import Icon from './Icon.astro';
---

<nav class="navbar" data-navbar>
  <a href="/" class="logo">
    <Banner />
    <span class="sr-only">Quarkdown</span>
  </a>
  <div class="links">
    <a href={links.wiki}>Wiki</a>
    <a href={links.blog}>Blog</a>
    <a href={links.repo} class="icon" aria-label="GitHub">
      <Icon name="github" />
    </a>
  </div>
</nav>

<style lang="scss">
  @use 'sass:color';
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem 2rem;
    transition: background-color 0.3s;

    @include md-down {
      padding: 1.2rem 1.5rem;
    }

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
    }

    // Color overlay
    &::before {
      background-color: color.scale($brand-800, $alpha: -60%);
      mask-image: linear-gradient(to bottom, black, transparent 80%);
      -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);

      @include md-down {
        background-color: transparent;
        mask-image: none;
        -webkit-mask-image: none;
      }
    }

    // Blur overlay
    &::after {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      mask-image: linear-gradient(to bottom, black 20%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent);
    }

    &:global(.scrolled) {
      @include md-down {
        background-color: $brand-700;
      }
    }
  }

  .links {
    display: flex;
    align-items: center;
    gap: 2rem;

    @include sm-down {
      margin-left: auto;
    }
  }

  a {
    font-family: $font-body;
    font-size: $font-size-nav;
    letter-spacing: $letter-spacing-body;
    color: $text;
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: $heading;
    }
  }

  .logo {
    :global(svg) {
      width: 128px;
      height: auto;
    }

    @include sm-down {
      display: none;
    }
  }

  .icon {
    display: flex;
    align-items: center;
    font-size: 1.2em;
  }
</style>

<script>
  const navbar = document.querySelector('[data-navbar]')!;
  const hero = document.querySelector('.hero-title');

  if (hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        navbar.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { threshold: 0 },
    );

    observer.observe(hero);
  } else {
    navbar.classList.add('scrolled');
  }
</script>
