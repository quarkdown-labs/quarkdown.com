---
import { links } from '../links';
import Banner from '../assets/banner.svg';
import Icon from './Icon.astro';

type IconName = Parameters<typeof Icon>[0]['name'];

interface NavLink {
  label: string;
  href: string;
  icon: IconName;
}

interface NavGroup {
  title: string;
  links: NavLink[];
}

const groups: NavGroup[] = [
  {
    title: 'Quarkdown Studio',
    links: [{ label: 'Try Studio', href: links.tryStudio, icon: 'app-window' }],
  },
  {
    title: 'Get started',
    links: [
      { label: 'Wiki', href: links.wiki, icon: 'book-open' },
      { label: 'Packages', href: links.packages, icon: 'orbit' },
    ],
  },
  {
    title: 'From us',
    links: [
      { label: 'GitHub', href: links.repo, icon: 'github' },
      { label: 'Blog', href: links.blog, icon: 'notebook-pen' },
    ],
  },
];
---

<nav class="navbar" data-navbar>
  <a href="/" class="logo">
    <Banner />
    <span class="sr-only">Quarkdown</span>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-label="Menu"
    aria-controls="navbar-menu"
    aria-expanded="false"
    data-menu-toggle
  >
    <Icon name="menu" class="menu-open-icon" />
    <Icon name="close" class="menu-close-icon" />
  </button>

  <div class="menu" id="navbar-menu">
    {groups.map(({ title, links }, i) => (
      <div class="group" role="group" aria-labelledby={`navbar-group-${i}`}>
        <span class="group-title" id={`navbar-group-${i}`}>{title}</span>
        {links.map(({ label, href, icon }) => (
          <a href={href}>
            <span>{label}</span>
            <Icon name={icon} />
          </a>
        ))}
      </div>
    ))}
  </div>
</nav>

<style lang="scss">
  @use 'sass:color';
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  // Height of the bar's overlays, which the menu's sections hang below on wide screens.
  $overlay-height: 5.75rem;
  $padding-x: 3rem;
  $padding-x-compact: 1.5rem;

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.5rem $padding-x 2rem;
    transition: background-color 0.3s;
    // The stacked menu makes the bar taller than its overlays: only its controls take clicks.
    pointer-events: none;

    a,
    button {
      pointer-events: auto;
    }

    @include md-down {
      align-items: center;
      padding: 1.2rem $padding-x-compact;
    }

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: $overlay-height;
      z-index: -1;

      @include md-down {
        bottom: 0;
        height: auto;
      }
    }

    // Color overlay
    &::before {
      background-color: color.scale($brand-800, $alpha: -60%);
      mask-image: linear-gradient(to bottom, black, transparent 80%);
      -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);

      @include md-down {
        background-color: transparent;
        mask-image: none;
        -webkit-mask-image: none;
      }
    }

    // Blur overlay
    &::after {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      mask-image: linear-gradient(to bottom, black 20%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent);
    }

    &:global(.scrolled),
    &[data-open] {
      @include md-down {
        background-color: $brand-700;
      }
    }
  }

  .logo {
    :global(svg) {
      width: 128px;
      height: auto;
      position: relative;
      top: 2px;
    }
  }

  // Wide screens stack the sections down the right edge; compact ones fold them behind the toggle.
  .menu {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.75rem;

    @include md-down {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      align-items: stretch;
      gap: 1.5rem;
      padding: 0.5rem $padding-x-compact 1.75rem;
      background-color: $brand-700;
      border-bottom: 1px solid $brand-500;
      pointer-events: auto;

      .navbar[data-open] & {
        display: flex;
      }
    }
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.9rem;

    @include md-down {
      align-items: flex-start;
    }
  }

  .group-title {
    @include overline;
    font-size: 0.7rem;
    color: $text-faint;
  }

  .menu-toggle {
    display: none;
    padding: 0.25rem;
    border: none;
    background: none;
    color: $heading;
    font-size: 1.5rem;
    cursor: pointer;

    @include md-down {
      display: flex;
    }

    :global(.menu-close-icon) {
      display: none;
    }
  }

  .navbar[data-open] .menu-toggle {
    :global(.menu-open-icon) {
      display: none;
    }

    :global(.menu-close-icon) {
      display: block;
    }
  }

  .menu a {
    @include overline;
    text-transform: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: $text;
    text-decoration: none;
    transition: color 0.2s;

    :global(svg) {
      font-size: 1.2em;
    }

    &:hover {
      color: $heading;
    }

    // Icons lead the names in the compact menu, which reads from the left.
    @include md-down {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
  }
</style>


<script>
  import { bp } from '../scripts/breakpoints';

  const navbar = document.querySelector<HTMLElement>('[data-navbar]')!;
  const toggle = navbar.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const hero = document.querySelector('.hero-title');

  function setOpen(open: boolean) {
    navbar.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', () => setOpen(!navbar.hasAttribute('data-open')));
  navbar.querySelectorAll('.menu a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => event.key === 'Escape' && setOpen(false));
  // The menu folds away for good once the screen widens past the toggle.
  matchMedia(`(min-width: ${bp.md + 1}px)`).addEventListener('change', () => setOpen(false));

  if (hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        navbar.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { threshold: 0 },
    );

    observer.observe(hero);
  } else {
    navbar.classList.add('scrolled');
  }
</script>
