---
import { links } from '../links';
import Banner from '../assets/banner.svg';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<nav class="navbar" data-navbar>
  <a href="/" class="logo" aria-label="Quarkdown">
    <Banner />
  </a>
  <div class="links">
    <a href={links.wiki}>Wiki</a>
    <a href={links.docs}>Docs</a>
    <a href={links.github} class="icon" aria-label="GitHub">
      <i class="bi bi-github"></i>
    </a>
  </div>
</nav>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem 2rem;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
    }

    // Color overlay
    &::before {
      background-color: transparentize($brand-800, 0.6);
      mask-image: linear-gradient(to bottom, black, transparent 80%);
      -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);
    }

    // Blur overlay
    &::after {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      mask-image: linear-gradient(to bottom, black 20%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent);
    }
  }

  .links {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  a {
    font-family: $font-body;
    font-size: $font-size-nav;
    letter-spacing: $letter-spacing-body;
    color: $text;
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: $heading;
    }
  }

  .logo {
    opacity: 0;
    transform: translateY(-0.3rem);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;

    :global(svg) {
      width: 128px;
      height: auto;
    }

    .navbar:global(.scrolled) & {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  .icon {
    display: flex;
    align-items: center;
    font-size: 1.2em;
  }
</style>

<script>
  const navbar = document.querySelector('[data-navbar]')!;
  const hero = document.querySelector('.hero-title')!;

  const observer = new IntersectionObserver(
    ([entry]) => {
      navbar.classList.toggle('scrolled', !entry.isIntersecting);
    },
    { threshold: 0 },
  );

  observer.observe(hero);
</script>
