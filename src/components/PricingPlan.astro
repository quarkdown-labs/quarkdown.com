---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import type { Plan } from '../plans';

interface Props {
  plan: Plan;
}

const { name, badge, price, highlighted, features, action } = Astro.props.plan;

// The fractional part of a price, if any, is typeset smaller than its whole part.
const [whole, fraction] = price?.amount.split('.') ?? [];
---

<article class:list={['plan', { 'plan--highlighted': highlighted }]} data-plan-highlighted={highlighted}>
  <header class="plan-header">
    <h2 class="plan-name">{name}</h2>
    {badge && <span class="plan-badge">{badge}</span>}
    {price && (
      <p class="plan-price">
        <span class="plan-price-amount">{whole}{fraction && <span class="plan-price-fraction">.{fraction}</span>}</span>
        {price.period && <span class="plan-price-period">/{price.period}</span>}
      </p>
    )}
  </header>

  <ul class="plan-features">
    {features.map((feature) => (
      <li>
        <Icon name="check" class="plan-check" />
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  {action && (
    <div class="plan-action">
      <CallToAction href={action.href} variant={action.variant}>{action.label}</CallToAction>
    </div>
  )}
</article>

<script>
  import { gsap, loadScrollTrigger } from '../scripts/gsap';

  // A glint sweeps across the highlighted plan's border as the page scrolls.
  const plans = document.querySelectorAll<HTMLElement>('[data-plan-highlighted]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (plans.length > 0 && !reducedMotion) {
    await loadScrollTrigger();

    plans.forEach((plan) => {
      gsap.fromTo(plan,
        { '--plan-shine': '-30%' },
        {
          '--plan-shine': '130%',
          ease: 'none',
          scrollTrigger: {
            trigger: plan,
            // The plan is visible on load: the animation starts from the very top of the page.
            start: 'clamp(top bottom)',
            end: 'clamp(top 15%)',
            scrub: 0.6,
          },
        },
      );
    });
  }
</script>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;
  @use '../styles/container' as *;

  $padding: 2rem;

  // Exposed so that layouts can account for it, e.g. when plans overlap.
  .plan {
    @include styled-container;
    --plan-padding: #{$padding};
    display: flex;
    flex-direction: column;
    padding: var(--plan-padding);
    text-align: start;

    @include sm-down {
      --plan-padding: #{$padding * 0.75};
    }
  }

  .plan--highlighted {
    --plan-shine: -30%;
    position: relative;
    background-color: $brand-700;
    border-color: $brand-300;

    // A glint laid over the border only: the gradient is masked out of the padding box.
    &::before {
      content: '';
      position: absolute;
      inset: (-$container-border-width) (-$container-border-width) (-$container-border-bottom-width);
      padding: $container-border-width $container-border-width $container-border-bottom-width;
      border-radius: inherit;
      background: linear-gradient(
        115deg,
        transparent calc(var(--plan-shine) - 25%),
        $heading var(--plan-shine),
        transparent calc(var(--plan-shine) + 25%)
      );
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      filter: drop-shadow(0 0 3px $heading) drop-shadow(0 0 8px rgba($heading, 0.6));
      pointer-events: none;
    }
  }

  .plan-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid $brand-600;
  }

  .plan-name {
    margin: 0;
    font-size: $font-size-h3;
  }

  .plan-badge {
    @include overline;
    color: $text-faint;
  }

  .plan-price {
    @include prose;
    flex-basis: 100%;
  }

  // The heading font lacks a consistent face for figures and symbols:
  // prices use the prose font, which matches the features and ships a semibold weight.
  .plan-price-amount {
    @include prose-heading;
    font-size: $font-size-h2;
    color: $heading;
  }

  .plan-price-fraction {
    font-size: 0.75em;
  }

  .plan-price-period {
    margin-left: 0.15em;
    color: $text-faint;
  }

  .plan-features {
    @include prose;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;

    li {
      display: flex;
      gap: 0.75rem;
    }
  }

  // Icon renders in its own component, out of reach of this component's scoped styles.
  // The check is centered on the first line of its feature, even when the text wraps.
  .plan-features :global(.plan-check) {
    flex-shrink: 0;
    margin-top: calc((1lh - 1em) / 2);
    color: $heading;
  }

  .plan-action {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 2rem;
  }
</style>
