---
interface Props {
  overline: string;
  title?: string;
  description: string;
}

const { overline, title, description } = Astro.props;
---

<section class="feature">
  <span class="feature-overline">{overline}</span>
  <h2 class="feature-title"><slot name="title">{title}</slot></h2>
  <p class="feature-description" set:html={description}></p>
  <div class="feature-content">
    <slot />
  </div>
</section>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 5rem 2rem;
    max-width: 1000px;
    margin: 0 auto;

    @include sm-down {
      align-items: start;
      text-align: start;
    }
  }

  .feature-overline {
    @include overline;
    color: $text-faint;
  }

  .feature-title {
    text-shadow: $glow;
  }

  .feature-description {
    @include text;
    margin-bottom: 3rem;
  }

  .feature-content {
    width: 100%;
  }
</style>
