---
interface Props {
  overline?: string;
  title?: string;
  description?: string;
  /** Alignment of the overline, title and description. */
  align?: 'center' | 'start';
  class?: string;
}

const { overline, title, description, align = 'center', class: className } = Astro.props;
---

<section class:list={['feature', `feature--${align}`, className]}>
  {(overline || Astro.slots.has('overline')) && <span class="feature-overline"><slot name="overline">{overline}</slot></span>}
  <h2 class="feature-title"><slot name="title">{title}</slot></h2>
  {description && <p class="feature-description" set:html={description}></p>}
  {Astro.slots.has('default') && (
    <div class="feature-content">
      <slot />
    </div>
  )}
</section>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  @mixin start-aligned {
    align-items: start;
    text-align: start;
  }

  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 5rem 2rem;
    max-width: 1000px;
    margin: 0 auto;

    @include sm-down {
      @include start-aligned;
    }
  }

  .feature--start {
    @include start-aligned;
  }

  .feature-overline {
    @include overline;
    color: $text-faint;
  }

  .feature-description {
    @include text;
  }

  .feature-content {
    width: 100%;
    margin-top: 3rem;
  }
</style>
