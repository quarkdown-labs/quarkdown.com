---
import CallToAction from './CallToAction.astro';
import { links } from '../links';

const methods = [
  {
    label: 'Linux / macOS',
    commands: ['curl -fsSL https://raw.githubusercontent.com/quarkdown-labs/get-quarkdown/refs/heads/main/install.sh | sudo env "PATH=$PATH" bash'],
  },
  {
    label: 'macOS (<a href="https://brew.sh">Homebrew</a>)',
    commands: ['brew install quarkdown-labs/quarkdown/quarkdown'],
  },
  {
    label: 'Windows',
    commands: ['irm https://raw.githubusercontent.com/quarkdown-labs/get-quarkdown/refs/heads/main/install.ps1 | iex'],
  },
  {
    label: 'Windows (<a href="https://scoop.sh">Scoop</a>)',
    commands: [
      'scoop bucket add java',
      'scoop bucket add quarkdown https://github.com/quarkdown-labs/scoop-quarkdown',
      'scoop install quarkdown',
    ],
  },
];
---

<section id="install" class="installation">
  <h2 class="installation-title">Installation</h2>
  <span class="installation-subtitle" data-release hidden><a data-release-tag target="_blank" rel="noopener"></a> <span class="installation-date">was released on <span data-release-date></span></span></span>

  <div class="installation-methods">
    {methods.map(({ label, commands }) => (
      <div class="method">
        <span class="method-label"><Fragment set:html={label} /></span>
        <div class="method-code-wrapper" data-copyable>
          <pre class="method-code"><code>{commands.join('\n')}</code></pre>
        </div>
      </div>
    ))}
  </div>

  <div class="installation-actions">
    <CallToAction href={links.quickstart} variant="primary">Get started &nbsp;&rarr;</CallToAction>
  </div>
</section>

<script>
  fetch('https://api.github.com/repos/iamgio/quarkdown/releases/latest')
    .then(res => res.json())
    .then(({ tag_name, published_at, html_url }) => {
      const container = document.querySelector<HTMLElement>('[data-release]');
      const tag = document.querySelector<HTMLAnchorElement>('[data-release-tag]');
      const date = document.querySelector<HTMLElement>('[data-release-date]');
      if (!container || !tag || !date) return;
      tag.textContent = tag_name;
      tag.href = html_url;
      date.textContent = new Date(published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      container.hidden = false;
    })
    .catch(() => {});
</script>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .installation {
    padding: 5rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .installation-title {
    text-align: center;
    font-size: $font-size-h1;
    margin-bottom: 0.5rem;
  }

  .installation-subtitle {
    display: block;
    text-align: center;
    font-family: $font-sans;
    font-size: $font-size-overline;
    color: $heading;
    margin-bottom: 3rem;

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .installation-date {
    color: $text-faint;
  }

  .installation-methods {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .method {
    display: flex;
    align-items: center;
    gap: 2rem;

    @include md-down {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
  }

  .method-label {
    flex-shrink: 0;
    width: 180px;
    text-align: right;
    font-family: $font-body;
    font-size: $font-size-body;
    color: $heading;

    @include md-down {
      width: auto;
      text-align: center;
      margin-bottom: 0.5rem;
    }

    :global(a) {
      color: $text;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .method-code-wrapper {
    flex: 1;
    position: relative;
    border-radius: 10px;
    min-width: 0;
  }

  .method-code {
    margin: 0;
  }

  code {
    font-size: #{$font-size-code + 0.03rem};
  }

  .installation-actions {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }
</style>
