---
/** The name of a plan, as a badge linking to the pricing page. */
import { plans, type Plan } from '../plans';
import { links } from '../links';

interface Props {
  plan: Plan['id'];
}

const { name } = plans.find(({ id }) => id === Astro.props.plan)!;
---

<a class="plan-badge" href={links.pricing}>{name}</a>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .plan-badge {
    display: inline-block;
    padding: 0.2em 0.55em;
    font-family: $font-sans;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: $letter-spacing-sans;
    line-height: 1;
    text-transform: none;
    vertical-align: middle;
    color: #fff;
    text-decoration: none;
    text-shadow: none;
    background: $studio;
    border-radius: 0.35em;
  }
</style>
