---
import StyledContainer from '../StyledContainer.astro';
---

<StyledContainer class="product-hunt">
  <h2>Quarkdown is on Product Hunt today</h2>
  <p>Your upvote shows your support and helps Quarkdown reach more people 💚</p>
  <a class="embed" href="https://www.producthunt.com/products/quarkdown?embed=true&amp;utm_source=embed&amp;utm_medium=post_embed" target="_blank" rel="noopener" style="display: block; text-decoration: none; text-align: start; font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif; border: 1px solid rgb(224, 224, 224); border-radius: 12px; padding: 20px; max-width: 500px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 8px;"><div style="display: flex; align-items: center; gap: 12px;"><img alt="Quarkdown" src="https://ph-files.imgix.net/063ff643-3829-48bd-9b0e-d7fc3f08e062.png?auto=format&amp;fit=crop&amp;w=80&amp;h=80" style="width: 64px; height: 64px; border-radius: 8px; object-fit: cover; flex-shrink: 0;"><div style="flex: 1 1 0%; min-width: 0px;"><h3 style="margin: 0px; font-size: 18px; font-weight: 600; color: rgb(26, 26, 26); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif; text-shadow: none;">Quarkdown</h3><p style="margin: 4px 0px 0px; font-size: 14px; color: rgb(102, 102, 102); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Markdown with superpowers: from ideas to stunning documents.</p></div></div><span style="display: inline-flex; align-items: center; gap: 4px; margin-top: 12px; padding: 8px 16px; background: rgb(255, 97, 84); color: rgb(255, 255, 255); border-radius: 8px; font-size: 14px; font-weight: 600;">Check it out on Product Hunt →</span></a>
</StyledContainer>

<style lang="scss">
  :global(.styled-container.product-hunt) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem 3rem 3rem;
    max-width: 900px;
    margin: 0 1.5rem;
    margin-inline: auto;

    .embed {
      margin-top: 1.5rem;
    }

    img {
      filter: none;
    }
  }
</style>
