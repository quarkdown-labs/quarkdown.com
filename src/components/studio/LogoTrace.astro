---
/**
 * The Quarkdown logo, unseen until `logoTrace` plays it: its outline traces itself, fills in, then swells and dissolves.
 * Centered on its closest positioned ancestor, behind that ancestor's content.
 */
import Logo from '../../assets/logo.svg';

interface Props {
  /** Height of the logo, relative to its positioned ancestor (e.g. `200%`) or absolute. */
  size?: string;
}

const { size = '200%' } = Astro.props;
---

<Logo class="logo-trace" style={{ '--size': size }} aria-hidden="true" data-logo-trace />

<style lang="scss">
  @use '../../styles/colors' as *;

  // --fill goes from 0 to 1 as the traced outline fills in.
  .logo-trace {
    --fill: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    height: var(--size);
    width: auto;
    translate: -50% -50%;
    color: $brand-400;
    opacity: 0;
    pointer-events: none;

    // Only the shapes the logo fills are traced thin, then filled; its stroked arrow keeps its own stroke.
    :global(path[fill]) {
      fill-opacity: var(--fill);
      stroke-width: 0.5;
    }
  }
</style>
