---
/** The Studio page's closing call to join the waitlist. */
import DotPattern from '../DotPattern.astro';
import WaitlistButton from './WaitlistButton.astro';
---

<section class="closing">
  <DotPattern />
  <div class="closing-inner">
    <h2>Be first in line</h2>
    <p>Join the waitlist and we'll let you know as soon as your Studio is ready.</p>
    <WaitlistButton />
  </div>
</section>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;

  $footer-margin: 2rem; // Footer's `margin-top`.

  .closing {
    position: relative;
    overflow: hidden;
    // A glow rather than a fill, so there is no edge against the page above, fading into the footer below.
    background:
      radial-gradient(ellipse 60% 55% at 50% 55%, rgba($brand-700, 0.9), transparent),
      linear-gradient(transparent 55%, $brand-muted);
    // Meets the footer, cancelling its top margin.
    margin-bottom: -$footer-margin;
  }

  .closing-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 10rem 1.5rem calc(6rem + #{$footer-margin});
    text-align: center;

    h2 {
      font-size: $font-size-h1;
    }

    p {
      @include text;
      max-width: 32rem;
    }
  }
</style>
