---
/**
 * Hero of the Studio page, staged as a particle collision: the title's letters draw together towards its center,
 * set off a shockwave as they lock in, and the screenshot rises out of depth into its tilt.
 */
import DotPattern from '../DotPattern.astro';
import ThemeSplitScreenshot from './ThemeSplitScreenshot.astro';
import WaitlistButton from './WaitlistButton.astro';

/** When the screenshot lands, in seconds into the entrance; its light and dark themes split as it does. */
const SCREENSHOT_LANDING = 1.6;

const lead = 'Subatomically';
const emphasis = 'spectacular';
---

<section class="hero">
  <DotPattern />

  <div class="hero-inner">
    <h1 class="hero-title" aria-label={`${lead} ${emphasis}`} data-hero-title>
      <span class="shockwave" aria-hidden="true" data-shockwave></span>
      <span class="lead" aria-hidden="true">
        {[...lead].map((char) => <span class="particle">{char}</span>)}
      </span>
      <strong aria-hidden="true">
        {[...emphasis].map((char) => <span class="particle">{char}</span>)}
      </strong>
    </h1>

    <p class="hero-subtitle" data-hero-rise>
      Quarkdown Studio brings the full power of Quarkdown to the browser.
      Write, preview and export, with nothing to install.
    </p>

    <div class="hero-actions" data-hero-rise>
      <WaitlistButton />
    </div>

    <div class="hero-screenshot" data-hero-screenshot data-landing={SCREENSHOT_LANDING}>
      <ThemeSplitScreenshot
        alt="Quarkdown Studio's editor, half in its light theme and half in its dark theme"
        introDelay={SCREENSHOT_LANDING}
      />
    </div>
  </div>
</section>

<script>
  import { gsap } from '../../scripts/gsap';

  const SPREAD = 0.35; // How far letters start from their place, relative to their distance from the title's center.
  const CONVERGENCE = 1;

  const title = document.querySelector<HTMLElement>('[data-hero-title]')!;
  const particles = title.querySelectorAll<HTMLElement>('.particle');
  const shockwave = document.querySelector<HTMLElement>('[data-shockwave]')!;
  const rising = document.querySelectorAll<HTMLElement>('[data-hero-rise]');
  const screenshot = document.querySelector<HTMLElement>('[data-hero-screenshot]')!;
  const landing = Number(screenshot.dataset.landing);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const impact = CONVERGENCE * 0.55;
    const { left, width } = title.getBoundingClientRect();
    const center = left + width / 2;

    /** Horizontal offset of [particle] from its place at the start, pushing it away from the title's center. */
    const spreadOf = (particle: HTMLElement) => {
      const { left, width } = particle.getBoundingClientRect();
      return (left + width / 2 - center) * SPREAD;
    };

    gsap.timeline()
      // Letters draw together towards the title's center, condensing out of a faint blur.
      .fromTo(particles, { '--spread': (_, particle) => `${spreadOf(particle)}px`, '--condense': 1 }, {
        '--spread': '0px',
        '--condense': 0,
        duration: CONVERGENCE,
        ease: 'expo.out',
      })
      // The collision: a ring of light bursts out of the title as the letters lock in.
      .fromTo(shockwave, { scale: 0.05, opacity: 1 }, {
        scale: 1,
        opacity: 0,
        duration: 1.8,
        ease: 'expo.out',
        immediateRender: false, // Stays unseen until the impact.
      }, impact)
      .fromTo(rising, { y: 24, opacity: 0, filter: 'blur(8px)' }, {
        y: 0,
        opacity: 1,
        filter: 'blur(0px)',
        duration: 1,
        ease: 'expo.out',
        stagger: 0.12,
        clearProps: 'all',
      }, impact * 0.75)
      // The screenshot rises out of depth and settles into its tilt.
      .fromTo(screenshot, { y: 220, z: -600, rotationX: 35, opacity: 0, transformPerspective: 1200 }, {
        y: 0,
        z: 0,
        rotationX: 0,
        opacity: 1,
        duration: 1.6,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      }, landing - 0.8);
  });
</script>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;
  @use '../../styles/breakpoints' as *;

  .hero {
    position: relative;
    background: linear-gradient($brand-700 -10%, $brand-900 70%);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7.5rem 2rem 6rem;

    @include md-down {
      padding: 7rem 1.5rem 4rem;
    }
  }

  .hero-title {
    position: relative;
    font-family: $font-body;
    font-size: $font-size-h1;
    line-height: 0.95;
    margin-bottom: 3.5rem;

    .lead,
    strong {
      display: block;
    }

    strong {
      @include heading;
      font-size: 1.35em;
      line-height: 1;
      margin: 0.12em 0 0;
    }
  }

  // A ring of light around the title, burst once by the entrance.
  .shockwave {
    $size: min(150vw, 100rem);
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    width: $size;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 2px solid rgba($brand-50, 0.8);
    background: radial-gradient(circle, transparent 60%, rgba($brand-100, 0.12) 100%);
    box-shadow: 0 0 80px rgba($brand-100, 0.5), inset 0 0 80px rgba($brand-100, 0.4);
    opacity: 0;
    pointer-events: none;
  }

  // On entrance, letters draw in by --spread and condense out of a blur as --condense goes from 1 to 0.
  // The entrance tweens these variables rather than inline styles, so letters are never handed over between styles.
  .particle {
    --spread: 0px;
    --condense: 0;
    display: inline-block;
    transform: translateX(var(--spread));
    opacity: calc(1 - var(--condense));
    filter: blur(calc(var(--condense) * 10px));
  }

  .hero-subtitle {
    @include text;
    max-width: 40rem;
    text-wrap: balance;
    margin-bottom: 3.5rem;

    @include sm-down {
      br {
        display: none;
      }
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    // Sets the actions apart from the screenshot tucked under them.
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.55));
  }

  // The copy stays above the screenshot, whose far edge tucks under the actions.
  .hero-title,
  .hero-subtitle,
  .hero-actions {
    position: relative;
    z-index: 1;
  }

  .hero-screenshot {
    width: 100%;
    max-width: 1100px;
    margin-top: clamp(-2.5rem, -2.5vw, -0.75rem);
  }
</style>
