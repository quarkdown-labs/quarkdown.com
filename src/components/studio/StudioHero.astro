---
/**
 * Hero of the Studio page. On entrance, the title's first word is typed out, then the second's letters
 * draw together towards its center out of a blur; the waitlist action rises in, and the screenshot rises
 * out of depth into its tilt.
 */
import DotPattern from '../DotPattern.astro';
import ThemeSplitScreenshot from './ThemeSplitScreenshot.astro';
import WaitlistButton from './WaitlistButton.astro';
import Typewriter from '../Typewriter.astro';
import StudioLockup from './StudioLockup.astro';
import editorLight from '../../assets/studio/editor-light.png';
import editorDark from '../../assets/studio/editor-dark.png';

/** Fraction of the emphasis's convergence after which it reads settled, and the rest of the hero follows. */
const SETTLED = 0.5;

/** Seconds the screenshot takes to land once it starts rising; its light and dark themes split as it does. */
const SCREENSHOT_RISE = 0.8;

const lead = 'Subatomically';
const TYPING_DELAY_MS = 45; // Per character of the lead.
const typingSeconds = (lead.length * TYPING_DELAY_MS) / 1000;

/**
 * The title's emphasis, split into letters that converge on entrance, [delay] seconds in, over [convergence] seconds.
 * It starts once the lead is typed out, so the lead reads first.
 */
const emphasis = { text: 'spectacular', delay: typingSeconds, convergence: 1.3 };

/** When the waitlist action and the screenshot start rising in: as soon as the emphasis reads settled. */
const followUp = emphasis.delay + emphasis.convergence * SETTLED;
---

<section class="hero">
  <DotPattern />

  <div class="hero-inner">
    <div class="hero-lockup">
      <StudioLockup />
    </div>

    <h1 class="hero-title" data-hero-title>
      <span class="lead"><Typewriter text={lead} delay={TYPING_DELAY_MS} start="load" /></span>
      <strong class="emphasis" aria-label={emphasis.text} data-delay={emphasis.delay} data-convergence={emphasis.convergence}>
        {[...emphasis.text].map((char) => <span class="particle" aria-hidden="true">{char}</span>)}
      </strong>
    </h1>

    <div class="hero-actions" data-hero-rise>
      <WaitlistButton />
    </div>

    <div class="hero-screenshot" data-hero-screenshot data-follow-up={followUp}>
      <ThemeSplitScreenshot
        light={editorLight}
        dark={editorDark}
        alt="Quarkdown Studio's editor, half in its light theme and half in its dark theme"
        introDelay={followUp + SCREENSHOT_RISE}
      />
    </div>
  </div>
</section>

<script>
  import { gsap } from '../../scripts/gsap';

  const SPREAD = 0.35; // How far letters start from their place, relative to their distance from the title's center.

  const title = document.querySelector<HTMLElement>('[data-hero-title]')!;
  const emphasis = title.querySelector<HTMLElement>('.emphasis')!;
  const rising = document.querySelectorAll<HTMLElement>('[data-hero-rise]');
  const screenshot = document.querySelector<HTMLElement>('[data-hero-screenshot]')!;
  const followUp = Number(screenshot.dataset.followUp);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const { left, width } = title.getBoundingClientRect();
    const center = left + width / 2;

    /** Horizontal offset of [particle] from its place at the start, pushing it away from the title's center. */
    const spreadOf = (particle: HTMLElement) => {
      const { left, width } = particle.getBoundingClientRect();
      return (left + width / 2 - center) * SPREAD;
    };

    const timeline = gsap.timeline();

    // The emphasis's letters draw together towards the title's center, condensing out of a faint blur.
    timeline.fromTo(emphasis.querySelectorAll<HTMLElement>('.particle'), {
      '--spread': (_, particle) => `${spreadOf(particle)}px`,
      '--condense': 1,
    }, {
      '--spread': '0px',
      '--condense': 0,
      duration: Number(emphasis.dataset.convergence),
      ease: 'power2.out',
    }, Number(emphasis.dataset.delay));

    timeline
      .fromTo(rising, { y: 24, opacity: 0, filter: 'blur(8px)' }, {
        y: 0,
        opacity: 1,
        filter: 'blur(0px)',
        duration: 1.8,
        ease: 'expo.out',
        stagger: 0.12,
        clearProps: 'all',
      }, followUp)
      // The screenshot rises out of depth and settles into its tilt.
      .fromTo(screenshot, { y: 220, z: -600, rotationX: 35, opacity: 0, transformPerspective: 1200 }, {
        y: 0,
        z: 0,
        rotationX: 0,
        opacity: 1,
        duration: 1.6,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      }, followUp);
  });
</script>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;
  @use '../../styles/breakpoints' as *;

  .hero {
    position: relative;
    background: linear-gradient($brand-700 -10%, $brand-900 70%);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7.5rem 2rem 6rem;

    @include md-down {
      padding: 7rem 1.5rem 4rem;
    }
  }

  .hero-lockup {
    font-size: 1.75rem;
    color: $brand-200;
    margin-bottom: 2rem;
  }

  .hero-title {
    position: relative;
    font-family: $font-body;
    font-size: $font-size-h1;
    line-height: 0.95;
    margin-bottom: 5rem;

    .lead,
    .emphasis {
      display: block;
    }

    strong {
      @include heading;
      font-size: 1.35em;
      line-height: 1;
      margin: 0.12em 0 0;
    }
  }

  // On entrance, letters draw in by --spread and condense out of a blur as --condense goes from 1 to 0.
  // The entrance tweens these variables rather than inline styles, so letters are never handed over between styles.
  .particle {
    --spread: 0px;
    --condense: 0;
    display: inline-block;
    transform: translateX(var(--spread));
    opacity: calc(1 - var(--condense));
    filter: blur(calc(var(--condense) * 10px));
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;

    > :global(*) {
      filter: drop-shadow(0 10px 18px rgba($brand-500, 0.5));
    }
  }

  // The title and action stay above the screenshot, whose far edge tucks under the actions.
  .hero-title,
  .hero-actions {
    position: relative;
    z-index: 1;
  }

  .hero-screenshot {
    width: 100%;
    max-width: 1100px;
    margin-top: clamp(-2.5rem, -2.5vw, -0.75rem);
  }
</style>
