---
/**
 * MCP as an atom: a Studio screenshot at the nucleus, orbited by the three things an agent can do to a project.
 * Each orbit is drawn twice, its far half behind the screenshot and its near half in front.
 */
import type { ComponentProps } from 'astro/types';
import Screenshot from './Screenshot.astro';

type Props = ComponentProps<typeof Screenshot>;

/** Each electron rests at the right tip of its orbit. */
const orbits = [
  { verb: 'read', angle: -16, rx: 470, ry: 140 },
  { verb: 'export', angle: 16, rx: 470, ry: 140 },
  { verb: 'write', angle: 0, rx: 400, ry: 250 },
];

const viewBox = '-500 -310 1000 620';
const layers = ['back', 'front'] as const;


---

<div class="agent-atom">
  {layers.map((layer) => (
    <svg class:list={['orbits', `orbits--${layer}`]} viewBox={viewBox} aria-hidden="true">
      {orbits.map((orbit, i) => (
        <g class="orbit" transform={`rotate(${orbit.angle})`}>
          {layer === 'front' && (
            <clipPath id={`orbit-near-${i}`}>
              <rect x={-orbit.rx - 20} y="0" width={orbit.rx * 2 + 40} height={orbit.ry + 20} />
            </clipPath>
          )}
          {layer === 'back' && <ellipse class="path-ghost" rx={orbit.rx} ry={orbit.ry} />}
          <ellipse class="path" rx={orbit.rx} ry={orbit.ry} clip-path={layer === 'front' ? `url(#orbit-near-${i})` : undefined} />
          {layer === 'front' && (
            <g class="electron" transform={`translate(${orbit.rx} 0)`}>
              <circle r="8" />
              <text x="16" y="6" transform={`rotate(${-orbit.angle})`}>{orbit.verb}</text>
            </g>
          )}
        </g>
      ))}
    </svg>
  ))}

  <div class="nucleus">
    <Screenshot {...Astro.props} />
  </div>
</div>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;

  $electron: #c792ea;
  $aspect: 1000 / 620;

  .agent-atom {
    position: relative;
    width: min(100%, 1100px);
    aspect-ratio: $aspect;
    margin: 0 auto;
  }

  .orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbits--front {
    z-index: 1;
  }

  .nucleus {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 58%;
    transform: translate(-50%, -50%);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 120px -30px rgba($electron, 0.25);
    border-radius: 14px;
  }

  .path-ghost {
    fill: none;
    stroke: $brand-600;
    stroke-width: 1.5;
  }

  .path {
    fill: none;
    stroke: $brand-200;
    stroke-width: 2;
    opacity: 0.35;
  }

  .electron {
    circle {
      fill: $electron;
      filter: drop-shadow(0 0 10px $electron);
    }

    text {
      font-family: $font-body;
      font-size: 24px;
      letter-spacing: $letter-spacing-body;
      fill: $heading;
    }
  }
</style>
