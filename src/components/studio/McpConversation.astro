---
/**
 * A recorded conversation with an AI agent working on a Studio project over MCP, as a chat.
 * The before close-up opens it from the user, and the after close-up follows the edit from the agent.
 * Turns come in one by one while the showcase visual is active, starting over on every visit.
 */
import type { ImageMetadata } from 'astro';
import Screenshot from './Screenshot.astro';

interface Message {
  role: 'user' | 'assistant';
  text: string;
}

interface ToolCall {
  role: 'tool';
  name: string;
  arguments: Record<string, unknown> & { path?: string; old_string?: string; new_string?: string };
  result: string;
}

export type Turn = Message | ToolCall;

interface Closeup {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  transcript: Turn[];
  before: Closeup;
  after: Closeup;
  /** Pixel density of the close-ups. */
  density: number;
}

const { transcript, before, after, density } = Astro.props;

const isEdit = (turn: Turn) => turn.role === 'tool' && turn.arguments.new_string !== undefined;

/** Labels of Studio's MCP tools. */
const ACTIONS: Record<string, string> = {
  read_file: 'Reading',
  edit_file: 'Editing',
};

/** [call]'s label, falling back to its tool's name. */
const actionOf = (call: ToolCall) => ACTIONS[call.name] ?? call.name;

interface CloseupMessage {
  role: 'user' | 'assistant';
  closeup: Closeup;
}

const edit = transcript.find(isEdit);

const messages: (Turn | CloseupMessage)[] = [
  { role: 'user', closeup: before },
  ...transcript.flatMap((turn): (Turn | CloseupMessage)[] => (turn === edit ? [turn, { role: 'assistant', closeup: after }] : [turn])),
];
---

<div class="conversation" data-conversation>
  <ol class="chat" aria-label="Conversation with an AI agent">
    {messages.map((message) => (
      <li class:list={['turn', `turn--${message.role}`]} data-turn>
        {'closeup' in message ? (
          <div class="closeup">
            <Screenshot image={message.closeup.image} alt={message.closeup.alt} density={density} />
          </div>
        ) : message.role === 'tool' ? (
          <p class="tool"><span class="tool-action">{actionOf(message)}</span> {message.arguments.path}</p>
        ) : (
          <p class="bubble">{message.text}</p>
        )}
      </li>
    ))}
  </ol>
</div>

<script>
  import { gsap } from '../../scripts/gsap';
  import { reportProgress, whileActive } from '../../scripts/showcase';
  import { media } from '../../scripts/breakpoints';

  const TURN_INTERVAL = 1.5; // Seconds.
  const TURN_DURATION = 0.6;

  document.querySelectorAll<HTMLElement>('[data-conversation]').forEach((conversation) => {
    const timeline = gsap.timeline({ paused: true, onUpdate: () => reportProgress(conversation, timeline.progress()) });
    // Read before the timeline sets any.
    const firstCall = conversation.querySelector('.tool');
    const finished = firstCall ? getComputedStyle(firstCall).opacity : 1;

    // Grown from no height, so earlier turns move up as in a chat.
    conversation.querySelectorAll<HTMLElement>('[data-turn]').forEach((turn, index) => {
      const at = index * TURN_INTERVAL;
      timeline.fromTo(turn, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: TURN_DURATION, ease: 'power2.out' }, at);

      // A tool call dims once the next turn comes.
      const call = turn.querySelector('.tool');
      if (call) timeline.fromTo(call, { opacity: 1 }, { opacity: finished, duration: TURN_DURATION }, at + TURN_INTERVAL);
    });

    whileActive(conversation, {
      // Not an entry animation: it plays from the start on every visit. With reduced motion, it shows the whole chat at once.
      activate: () => {
        if (matchMedia(media.reducedMotion).matches) timeline.progress(1).pause();
        else timeline.restart();
      },
      deactivate: () => timeline.pause(),
    });
  });
</script>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;

  $chat-fade: 1.5rem;
  $bubble-radius: 12px;
  $bubble-padding-x: 0.85rem;

  // Fills its height, earlier turns overflowing at the top. Raised by --chat-lift, inset by --bleed-inset.
  .conversation {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    translate: 0 calc(-1 * var(--chat-lift, 0%));
    padding-inline-start: var(--bleed-inset, 0);
    font-size: 0.85rem;
  }

  .chat {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: $chat-fade;
    overflow: hidden;
    list-style: none;
    mask-image: linear-gradient(transparent, #000 $chat-fade);
  }

  // Spacing lives inside each turn, so it grows in with it.
  .turn {
    flex-shrink: 0;
    display: flex;
    overflow: hidden;

    > * {
      margin-top: 1.25rem;
      max-width: 85%;
    }
  }

  .turn--user {
    justify-content: end;
  }

  .bubble {
    @include prose;
    padding: 0.5rem $bubble-padding-x;
    border-radius: $bubble-radius;
  }

  .turn--user .bubble {
    color: $heading;
    background: $brand-500;
    border-bottom-right-radius: 4px;
  }

  .turn--assistant .bubble {
    color: $text;
    background: $brand-700;
    border-bottom-left-radius: 4px;
  }

  .closeup {
    display: flex;
    width: 100%;

    .turn--user & {
      justify-content: end;
    }
  }

  // Aligned with the bubbles' text. Dimmed when finished.
  .tool {
    @include prose;
    opacity: 0.5;
    padding-inline: $bubble-padding-x;
    font-size: calc(#{$font-size-prose} * 0.85);
    color: $text-faint;
  }

  .tool-action {
    color: $heading;
  }
</style>
