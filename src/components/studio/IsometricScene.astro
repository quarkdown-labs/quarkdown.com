---
/**
 * A large screenshot laid down in isometric view, floating over its own dark glow.
 * As the visitor scrolls past, it glides along its plane and slowly turns.
 */
import type { ComponentProps } from 'astro/types';
import Screenshot from './Screenshot.astro';

type Props = ComponentProps<typeof Screenshot>;
---

<div class="isometric-scene" data-isometric-scene>
  <div class="plane" data-plane>
    <div class="glow" aria-hidden="true"></div>
    <Screenshot {...Astro.props} />
  </div>
</div>

<script>
  import { gsap, loadScrollTrigger } from '../../scripts/gsap';

  const scene = document.querySelector<HTMLElement>('[data-isometric-scene]')!;
  const plane = scene.querySelector<HTMLElement>('[data-plane]')!;

  await loadScrollTrigger();

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.fromTo(plane, { '--drift': -1 }, {
      '--drift': 1,
      ease: 'none',
      scrollTrigger: { trigger: scene, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
    });
  });
</script>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/breakpoints' as *;

  $view-x: 56deg;
  $view-z: -38deg;
  $turn: 6deg; // Extra turn over the whole scroll.
  $glide: 9%; // Glide along the plane over the whole scroll.

  .isometric-scene {
    position: relative;
    height: clamp(30rem, 80vh, 52rem);
    perspective: 2400px;
    pointer-events: none;

    @include sm-down {
      height: 26rem;
    }
  }

  // --drift runs from -1 to 1 as the scene crosses the viewport.
  .plane {
    --drift: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(20rem, 68vw, 64rem);

    @include sm-down {
      width: 115vw;
    }
    transform-style: preserve-3d;
    transform:
      translate(-50%, -50%)
      rotateX($view-x)
      rotateZ(calc(#{$view-z} + var(--drift) * #{$turn}))
      translate(calc(var(--drift) * #{$glide}), calc(var(--drift) * -#{$glide}));
  }

  // Lifts the screenshot's edge off the ground in the dark theme.
  .plane :global(.screenshot) {
    box-shadow: 0 0 0 1px rgba($brand-200, 0.25), 0 0 80px -20px rgba($brand-100, 0.2);
  }

  // A dark shadow cast beneath the floating screenshot.
  .glow {
    position: absolute;
    inset: 4% -4% -8% 4%;
    border-radius: 40px;
    background: rgba(0, 0, 0, 0.9);
    filter: blur(70px);
    transform: translateZ(-80px);
  }
</style>
