---
/**
 * The Quarkdown Studio lockup: the Quarkdown mark on its disc, followed by the "Studio" wordmark,
 * as in Studio itself. Ink draws in the current text color, and the disc in a faint wash of it.
 */
import lockup from '../../assets/studio-lockup.svg?raw';
---

<span class="lockup" set:html={lockup} />

<style lang="scss">
  .lockup :global(svg) {
    display: block;
    height: 1.5em;
    width: auto;
  }
</style>
