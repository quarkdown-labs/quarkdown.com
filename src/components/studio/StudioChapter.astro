---
/**
 * A chapter of the Studio page: a heading and its pitch, centered over a scene.
 * Stacked, the text leads the scene; overlaid, the text sits on top of it.
 */
interface Props {
  title: string;
  description: string;
  layout?: 'stacked' | 'overlay';
}

const { title, description, layout = 'stacked' } = Astro.props;
---

<section class:list={['chapter', `chapter--${layout}`]}>
  <div class="chapter-text">
    <h2>{title}</h2>
    <p set:html={description} />
  </div>
  <div class="chapter-scene">
    <slot />
  </div>
</section>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;
  @use '../../styles/breakpoints' as *;

  .chapter {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 6rem 2rem;

    @include md-down {
      padding: 5rem 1.5rem;
    }
  }

  .chapter-text {
    max-width: 38rem;
    text-align: center;

    h2 {
      text-wrap: balance;
    }

    p {
      @include text;
      margin-top: 1.5rem;
      text-wrap: pretty;
    }
  }

  .chapter-scene {
    width: 100%;
  }

  .chapter--stacked {
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  // Text and scene share one grid cell, the text on top of a scrim that keeps it legible over the scene.
  .chapter--overlay {
    align-items: center;
    overflow-x: clip;

    > * {
      grid-area: 1 / 1;
    }

    .chapter-text {
      position: relative;
      z-index: 1;

      &::before {
        content: '';
        position: absolute;
        inset: -60% -30%;
        z-index: -1;
        background: radial-gradient(closest-side, rgba($brand-900, 0.95) 40%, transparent);
      }
    }
  }
</style>
