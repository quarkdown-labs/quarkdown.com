---
/**
 * A screen recording of Studio as a looping video, optionally zoomed by a camera timeline.
 * It plays from the start whenever its showcase visual becomes active. A viewport ahead of it, it is downloaded whole
 * and played from memory: Safari, streaming it, would run out of data partway through its first play.
 */
import type { CameraTimeline } from '../../scripts/camera';

interface Props {
  /** URL of the video. */
  src: string;
  camera?: CameraTimeline;
  alt: string;
}

const { src, camera, alt } = Astro.props;
---

<div class="recording" data-recording data-src={src} data-camera={camera && JSON.stringify(camera)}>
  <video
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    disableremoteplayback
    role="img"
    aria-label={alt}
  ></video>
</div>

<script>
  import { cameraOf } from '../../scripts/camera';
  import { RecordingPlayer } from '../../scripts/recording';
  import { reportProgress, whileActive } from '../../scripts/showcase';
  import { media } from '../../scripts/breakpoints';

  const PRELOAD_MARGIN = '100% 0px'; // One viewport ahead.

  document.querySelectorAll<HTMLElement>('[data-recording]').forEach((recording) => {
    const video = recording.querySelector('video')!;
    const { src, camera } = recording.dataset;
    const player = new RecordingPlayer(
      video,
      cameraOf(camera ? JSON.parse(camera) : undefined),
      (progress) => reportProgress(recording, progress),
    );

    /** Downloads the video whole, or streams it if that fails. The time fragment makes Safari show the first frame. */
    async function load() {
      try {
        const response = await fetch(src!);
        if (!response.ok) throw new Error(response.statusText);
        video.src = `${URL.createObjectURL(await response.blob())}#t=0.001`;
      } catch {
        video.src = `${src}#t=0.001`;
      }
    }

    const preload = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      preload.disconnect();
      void load();
    }, { rootMargin: PRELOAD_MARGIN });
    preload.observe(recording);

    whileActive(recording, {
      // Not an entry animation: it plays from the start on every visit. With reduced motion, it stays still.
      activate: () => {
        if (!matchMedia(media.reducedMotion).matches) player.play();
      },
      deactivate: () => player.pause(),
    });
  });
</script>

<style lang="scss">
  @use '../../styles/screenshot' as *;

  .recording {
    @include screenshot-frame;
    width: 100%;
    background: $screenshot-light-ground;
  }

  // Zoomed by the camera from its top left corner.
  video {
    @include screenshot-image;
    display: block;
    transform-origin: top left;
    will-change: transform;
  }
</style>
