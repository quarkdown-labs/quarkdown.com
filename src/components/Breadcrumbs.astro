---
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  items: Crumb[];
  separator?: string;
}

const { items, separator = '/' } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">{separator}</span>}
      <a href={item.href}>{item.label}</a>
    </>
  ))}
</nav>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  .breadcrumbs {
    font-family: $font-sans;
    font-size: $font-size-overline;
    letter-spacing: $letter-spacing-sans;
    color: $text-faint;
    display: flex;
    justify-content: center;
    gap: 0.5em;

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s;

      &:hover {
        color: $heading;
      }
    }

    .sep {
      opacity: 0.5;
    }
  }
</style>
