---
import 'bootstrap-icons/font/bootstrap-icons.css';
import Logo from '../assets/logo.svg';

const year = new Date().getFullYear();
---

<footer class="footer">
  <Logo class="background-logo" aria-hidden="true" />
  <p>Quarkdown &copy; 2024&ndash;{year}</p>
  <p class="credits">By <a href="https://github.com/iamgio" target="_blank" rel="noopener">Giorgio Garofalo (iamgio)</a> and contributors</p>
  <div class="footer-links">
    <a href="https://linkedin.com/in/giorgio-garofalo" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
    <a href="https://github.com/iamgio/quarkdown" target="_blank" rel="noopener" aria-label="GitHub"><i class="bi bi-github"></i></a>
  </div>
  <p class="image-credits">Image credits: Wikipedia, Alaska.org, Aluna1</p>
</footer>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;

  $overlay-color: $brand-700;

  .footer {
    position: relative;
    overflow: hidden;
    font-size: $font-size-footer;
    background-color: $brand-muted;
    text-align: center;
    padding: 2rem 1.5rem;
    color: $text;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    border-top: 4px solid $overlay-color;

    > :not(.background-logo) {
      position: relative;
      z-index: 1;
    }
  }

  .background-logo {
    position: absolute;
    top: 50%;
    left: 25%;
    transform: translate(-50%, -50%);
    height: 130%;
    width: auto;
    color: $overlay-color;
    z-index: 0;
    pointer-events: none;
  }

  .credits, .image-credits {
    color: $text-faint;
  }

  .image-credits {
    margin-top: 1rem;
    opacity: 0.7;
    font-size: $font-size-footnote;
  }

  a {
    color: currentColor;
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    font-size: $font-size-h3;
    margin-top: 1rem;
  }
</style>
