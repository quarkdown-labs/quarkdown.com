---
import 'bootstrap-icons/font/bootstrap-icons.css';
import Logo from '../assets/logo.svg';
import { links } from '../links';

const year = new Date().getFullYear();
---

<footer class="footer">
  <Logo class="background-logo" aria-hidden="true" />
  <div class="footer-columns">
    <div class="footer-col">
      <p>Quarkdown &copy; 2024&ndash;{year}</p>
      <p class="credits">By <a href="https://github.com/iamgio" target="_blank" rel="noopener">Giorgio Garofalo (iamgio)</a> and contributors</p>
      <p class="image-credits">Image credits: Wikipedia, Alaska.org, Aluna1</p>
      <div class="footer-socials">
        <a href="https://linkedin.com/in/giorgio-garofalo" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
        <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub"><i class="bi bi-github"></i></a>
      </div>
    </div>
    <div class="footer-col footer-col-right">
      <nav>
        <a href={links.wiki}>Wiki</a>
        <a href={links.quickstart}>Quickstart</a>
        <a href={links.docs}>Docs</a>
        <a href={links.vsCode}>VS Code</a>
      </nav>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  $overlay-color: $brand-700;

  .footer {
    position: relative;
    overflow: hidden;
    font-size: $font-size-footer;
    background-color: $brand-muted;
    padding: 2rem 3rem;
    color: $text;
    border-top: 4px solid $overlay-color;
  }

  .background-logo {
    position: absolute;
    top: 50%;
    left: 5%;
    transform: translate(-50%, -50%);
    height: 130%;
    width: auto;
    color: $overlay-color;
    z-index: 0;
    pointer-events: none;
  }

  .footer-columns {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: start;
    max-width: 1000px;
    margin: 0 auto;

    @include sm-down {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col-right {
    align-items: end;
    gap: 1rem;

    @include sm-down {
      align-items: start;
    }
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .footer-socials {
    display: flex;
    gap: 1.5rem;
    font-size: $font-size-h3;
    margin-top: 1rem;
  }

  .credits, .image-credits {
    color: $text-faint;
  }

  .image-credits {
    margin-top: 0.5rem;
    opacity: 0.7;
    font-size: $font-size-footnote;
  }

  a {
    color: currentColor;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
