---
/**
 * Decorative background layer spanning the entire page.
 * Renders blurred glow ovals at alternating left/right viewport edges,
 * plus a noise texture overlay. Purely visual — hidden from assistive tech.
 */
---

<div class="bg-effects" aria-hidden="true">
  <div class="glow glow--right glow--1"></div>
  <div class="glow glow--left glow--2"></div>
  <div class="glow glow--center glow--3"></div>
  <div class="glow glow--center glow--4"></div>
  <div class="noise"></div>
</div>

<style lang="scss">
  @use '../styles/colors' as *;

  .bg-effects {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .glow {
    position: absolute;
    width: 700px;
    height: 1500px;

    &--left {
      left: -350px;
    }

    &--right {
      right: -350px;
    }

    &--center {
      left: 50%;
      transform: translateX(-50%);
    }

    &--1 {
      top: 17%;
      background: radial-gradient(ellipse, $brand-600, transparent 60%);
    }

    &--2 {
      top: 45%;
      background: radial-gradient(ellipse, #21282D, transparent 70%);
    }

    &--3 {
      top: 35%;
      background: radial-gradient(ellipse, #152C2A, transparent 70%);
    }

    &--4 {
      top: 80%;
      background: radial-gradient(ellipse, #131423, transparent 70%);
    }
  }
</style>
