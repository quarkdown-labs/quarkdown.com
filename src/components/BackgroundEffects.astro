---
/**
 * Decorative background layer spanning the entire page.
 * Renders blurred glow ovals at alternating left/right viewport edges,
 * plus a noise texture overlay. Purely visual — hidden from assistive tech.
 */
type Side = 'left' | 'right' | 'center';

interface Props {
  /** Numbers of the glows to leave out, counting from 1 as their `glow--<number>` classes do. */
  without?: number[];
}

const { without = [] } = Astro.props;

const glows: Side[] = ['right', 'left', 'center', 'center'];
---

<div class="bg-effects" aria-hidden="true">
  {glows.map((side, index) => !without.includes(index + 1) && (
    <div class:list={['glow', `glow--${side}`, `glow--${index + 1}`]}></div>
  ))}
  <div class="noise"></div>
</div>

<style lang="scss">
  @use '../styles/colors' as *;

  .bg-effects {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .glow {
    position: absolute;
    width: 700px;
    height: 1500px;

    &--left {
      left: -350px;
    }

    &--right {
      right: -350px;
    }

    &--center {
      left: 50%;
      transform: translateX(-50%);
    }

    &--1 {
      top: 17%;
      background: radial-gradient(ellipse, $brand-600, transparent 60%);
    }

    &--2 {
      top: 45%;
      background: radial-gradient(ellipse, #21282D, transparent 70%);
    }

    &--3 {
      top: 35%;
      background: radial-gradient(ellipse, #152C2A, transparent 70%);
    }

    &--4 {
      top: 80%;
      background: radial-gradient(ellipse, #131423, transparent 70%);
    }
  }
</style>
