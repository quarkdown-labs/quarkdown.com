---
import CallToAction from './CallToAction.astro';
import { links } from '../links';
---

<div class="action-pair">
  <CallToAction href="#install" variant="secondary">Install</CallToAction>
  <CallToAction href={links.quickstart} variant="primary">Get started &nbsp;&rarr;</CallToAction>
</div>

<style lang="scss">
  .action-pair {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
