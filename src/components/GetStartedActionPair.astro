---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { links } from '../links';
import { withStudioLockup } from '../studio-name';
---

<div class="action-pair">
  <CallToAction href={links.tryStudio} variant="secondary"><Fragment set:html={withStudioLockup('Try Studio')} /></CallToAction>
  <CallToAction href={links.install} variant="primary">Get started<Icon name="arrow-right" /></CallToAction>
</div>

<style lang="scss">
  .action-pair {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  // Closer than the action's gap, as a word.
  .action-pair :global(.studio-inline svg) {
    margin-inline-start: -0.3em;
  }
</style>
