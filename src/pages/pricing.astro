---
import Base from '../layouts/Base.astro';
import BackgroundEffects from '../components/BackgroundEffects.astro';
import Feature from '../components/Feature.astro';
import PricingPlan from '../components/PricingPlan.astro';
import PlanComparison from '../components/PlanComparison.astro';
import TabSwitcher from '../components/TabSwitcher.astro';
import Faq from '../components/Faq.astro';
import { pricingFaqs } from '../faqs';
import Footer from '../components/Footer.astro';
import { billingIntervals, plans, refundWindowDays } from '../plans';
import { currencies } from '../currencies';
import { educationDiscount } from '../education';
import { contactEmail, links, mailto } from '../links';
import { meta } from '../meta';

const title = `Pricing | ${meta.name}`;
const description = `Compare ${meta.name} plans: Free, Pro and Enterprise.`;
const moneyBack =
  `Email <a href="${mailto()}">${contactEmail}</a> ` +
  `within ${refundWindowDays} days of your first payment for a full refund, no questions asked.`;
---

<Base title={title} description={description}>
  <BackgroundEffects />

  <main class="pricing" data-billing={billingIntervals[0].id} data-currency={currencies[0].id}>
    <h1 class="pricing-title">Pricing</h1>
    <p class="lead">Supercharge your flow with {meta.name} Studio.</p>

    <div class="switch">
      <TabSwitcher scope="billing" label="Billing period" options={billingIntervals} />
    </div>

    <div class="plans">
      {plans.map((plan) => <PricingPlan plan={plan} />)}
    </div>

    <div class="currency">
      <TabSwitcher scope="currency" label="Currency" options={currencies} size="small" />
    </div>

    <p class="education">
      Are you a student or educator? <a href={links.education}>Get {educationDiscount} off Pro</a>.
    </p>
  </main>

  <Feature title="Compare plans">
    <PlanComparison />
  </Feature>

  <Feature
    overline="Not your cup of tea?"
    title="Money-back guarantee"
    description={moneyBack}
  />

  <Feature title="Frequently asked questions">
    <Faq items={pricingFaqs} />
  </Feature>

  <Footer />

  <script>
    import { guessCurrency } from '../currencies';

    // Prices open in the currency the visitor most likely pays in, which the currency switcher can still change.
    const currency = guessCurrency(Intl.DateTimeFormat().resolvedOptions().timeZone, navigator.languages);
    document
      .querySelector<HTMLButtonElement>(`[data-tab-scope="currency"] [data-tab-option="${currency}"]`)
      ?.click();
  </script>
</Base>

<style lang="scss">
  @use '../styles/colors' as *;
  @use '../styles/typography' as *;
  @use '../styles/breakpoints' as *;

  .pricing {
    max-width: 1200px;
    margin: 0 auto;
    padding: 9rem 1.5rem 6rem;
    text-align: center;

    @include md-down {
      padding-top: 7rem;
    }
  }

  .lead {
    @include text;
    margin-top: 1rem;
  }

  .switch {
    margin-top: 2.5rem;
  }

  // Only the prices and actions of the selected [scope] value show: those tagged with another [values] are hidden.
  @mixin selected-only($scope, $attribute, $values) {
    @each $shown in $values {
      @each $hidden in $values {
        @if $shown != $hidden {
          .pricing[data-#{$scope}='#{$shown}'] :global([data-#{$attribute}='#{$hidden}']) {
            display: none;
          }
        }
      }
    }
  }

  @include selected-only(billing, interval, (monthly, yearly));
  @include selected-only(currency, currency, (usd, eur, gbp));

  $highlight-overflow: 1.5rem;
  $highlight-overlap: 1rem;
  $stacked-gap: 1.5rem;
  $neighbor-tilt: 6deg;
  $neighbor-perspective: 1200px;

  .currency {
    // Clears the highlighted plan, which extends below the others.
    margin-top: calc(#{$highlight-overflow} + 3rem);
  }

  .education {
    @include prose;
    margin-top: 4rem;

    a {
      color: $heading;
    }
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 5rem;

    // Plans in a row share their height, so that their actions line up at the bottom.
    // The highlighted plan stands out by extending past its neighbors on both ends,
    // and by overlapping their edges from above.
    :global(.plan--highlighted) {
      z-index: 1;
      margin: (-$highlight-overflow) (-$highlight-overlap);
    }

    // Neighbors win back the room the highlighted plan covers on their inner edge,
    // and turn slightly towards it, their inner edge receding behind it.
    // General sibling combinators, as non-plan siblings (e.g. hoisted scripts) may sit in between.
    :global(.plan:has(~ .plan--highlighted)) {
      padding-inline-end: calc(var(--plan-padding) + #{$highlight-overlap});
      transform-origin: left center;
      transform: perspective($neighbor-perspective) rotateY($neighbor-tilt);
    }

    :global(.plan--highlighted ~ .plan) {
      padding-inline-start: calc(var(--plan-padding) + #{$highlight-overlap});
      transform-origin: right center;
      transform: perspective($neighbor-perspective) rotateY(-$neighbor-tilt);
    }

    @include md-down {
      grid-template-columns: 1fr;
      gap: $stacked-gap;
      max-width: 520px;
      margin-inline: auto;

      :global(.plan--highlighted) {
        margin: 0;
      }

      :global(.plan:has(~ .plan--highlighted)),
      :global(.plan--highlighted ~ .plan) {
        padding-inline: var(--plan-padding);
        transform: none;
      }
    }
  }
</style>
