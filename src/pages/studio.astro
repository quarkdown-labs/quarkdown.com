---
import Base from '../layouts/Base.astro';
import BackgroundEffects from '../components/BackgroundEffects.astro';
import Footer from '../components/Footer.astro';
import StudioHero from '../components/studio/StudioHero.astro';
import Feature from '../components/Feature.astro';
import Faq from '../components/Faq.astro';
import { studioFaqs } from '../faqs';
import { meta } from '../meta';

const title = `${meta.name} Studio | Subatomically spectacular`;
const description = `${meta.name} Studio brings the full power of ${meta.name} to your browser. Write, preview and export, with nothing to install.`;
---

<Base title={title} description={description}>
  <BackgroundEffects />
  <StudioHero />

  <Feature title="Frequently asked questions">
    <Faq items={studioFaqs} />
  </Feature>

  <Footer />
</Base>

