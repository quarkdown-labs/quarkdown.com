---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import ReactivePreview from '../components/ReactivePreview.astro';
import QuarkdownCode from '../components/QuarkdownCode.astro';
import Typewriter from '../components/Typewriter.astro';
import Installation from '../components/Installation.astro';
import Footer from '../components/Footer.astro';
import DoctypeShowcase from '../components/DoctypeShowcase.astro';
import AuthoringShowcase from '../components/AuthoringShowcase.astro';
import AgentShowcase from '../components/AgentShowcase.astro';
import ProductHuntAlert from '../components/alerts/ProductHuntAlert.astro';
import { noBoilerplate, scripting } from '../codes';
import noBoilerplateOutput from '../assets/output/no-boilerplate.jpg';
import scriptingOutput from '../assets/output/scripting.png';
---

<Base>
  <Hero />

  <main class="features">
    <Feature
      overline="No boilerplate"
      description="and don't worry about the rest."
    >
      <Fragment slot="title">Spend your time <Typewriter text="writing" /></Fragment>
      <QuarkdownCode code={noBoilerplate} output={noBoilerplateOutput} alt="Rendered article about X-ray flashes from a supermassive black hole" />
    </Feature>
    
    <Feature
      overline="Batteries included"
      title="Complete authoring experience"
      description="Write Markdown to reach flow state faster.<br>Use Quarkdown's extensions to achieve more."
    >
      <AuthoringShowcase />
    </Feature>

    <Feature
      overline="Ready for autopilot"
      title="Agent-friendly"
      description="Let your AI agent speak fluent Quarkdown with built-in skills."
    >
      <AgentShowcase />
    </Feature>

    <div class="contained-section">
      <Feature
        overline="Versatile"
        title="One tool to rule them all"
        description="Whether you are writing a research paper, a quick report, a company-wide wiki, class notes, or preparing interactive slides for your next talk, there's only one line you need."
      >
        <DoctypeShowcase />
      </Feature>
    </div>

    <Feature
      overline="Reactive preview"
      title="Typesetting for the impatient"
      description="With blazing fast compilation and live preview, see results instantly as you type."
    >
      <ReactivePreview />
    </Feature>
 
    <Feature
      overline="Turing complete"
      title="Don't repeat yourself"
      description="Reuse your workflow thanks to powerful scripting capabilities."
    >
      <QuarkdownCode prioritizeCode code={scripting} output={scriptingOutput} alt="Animal cards rendered from a custom function" />
    </Feature>
  </main>

  <Installation />

  <Feature
    overline="Over 10K stars"
    description="Quarkdown's compiler is actively evolving, and will stay free and open source forever."
  >
    <Fragment slot="title">Open source, proudly made in <span class="italy">Italy</span></Fragment>
  </Feature>

  <Footer />
</Base>

<style lang="scss">
  @use '../styles/colors' as *;

  .features {
    overflow: hidden;
  }

  .contained-section {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 2rem;
    max-width: 1400px;
    margin: 4rem auto 0;
  }

  .italy {
    background: linear-gradient(
      90deg,
      #a8d4a8,
      $heading 40%,
      $heading 60%,
      #dba0a0
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
