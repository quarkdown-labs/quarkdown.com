---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { links } from '../../links';
import { meta } from '../../meta';
// Regenerated by the `Update emoji list` workflow of the Quarkdown repository.
import table from '../../generated/emoji-list.html?raw';

const title = `Emoji cheat sheet | ${meta.name}`;
const description = 'Every emoji shortcode supported by Quarkdown.';

// Every row is an emoji, except for the header one.
const count = (table.match(/<tr>/g)?.length ?? 1) - 1;
---

<Base title={title} description={description}>
  <main class="cheat-sheet">
    <header>
      <div class="breadcrumbs-row">
        <Breadcrumbs items={[
          { href: '/', label: meta.name },
          { href: `${links.tools}`, label: 'Tools' },
          { href: `${links.wiki}/emojis`, label: 'Emojis' },
        ]} />
      </div>
      <h1 class="hero-title">Emoji cheat sheet</h1>
      <p class="lead">
        For <code>.emoji &#123;name&#125;</code> in any Quarkdown document.
        See more in the <a href={`${links.wiki}/emojis`}>emoji guide</a>.
      </p>
    </header>

    <article class="prose emoji-table" set:html={table} />
  </main>

  <Footer />
</Base>

<style lang="scss">
  @use '../../styles/colors' as *;
  @use '../../styles/typography' as *;
  @use '../../styles/breakpoints' as *;

  .cheat-sheet {
    max-width: 760px;
    margin: 0 auto;
    padding: 9rem 1.5rem 5rem;

    @include md-down {
      padding-top: 7rem;
    }
  }

  header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-title {
    font-family: $font-prose;
    font-size: $font-size-h1-prose;
    font-weight: 700;
    letter-spacing: normal;
  }

  .breadcrumbs-row {
    margin-bottom: 1.25rem;
  }

  .overline {
    @include overline;
    color: $text-faint;
    margin-bottom: 1.5rem;
  }

  .lead {
    @include prose;
    margin-top: 1.25rem;
  }

  // The generated table carries no styling of its own: the site theme supplies it.
  // The oversized emoji sits high against its code cell, so it gets extra room above.
  .emoji-table :global(td:first-child) {
    font-size: 1.6em;
    line-height: 1;
    white-space: nowrap;
    padding-top: 0.8rem;
  }

  .emoji-table :global(th:first-child),
  .emoji-table :global(td:first-child) {
    width: 30%;
    text-align: center;
  }

  // The code column reads as a list of names: keep it against the left edge.
  .emoji-table :global(th:not(:first-child)),
  .emoji-table :global(td:not(:first-child)) {
    text-align: start;
  }

  .emoji-table :global(table) {
    margin-top: 0;
  }
</style>
